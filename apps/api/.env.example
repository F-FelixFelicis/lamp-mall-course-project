APP_ENV=local
# Local default: sqlite file in apps/api/.local/lamp_mall.db
# DATABASE_URL=mysql+pymysql://lamp_user:change_me@127.0.0.1:3306/lamp_mall?charset=utf8mb4
# Set a long random secret in shared environments. Local default is regenerated on every startup.
# JWT_SECRET=replace-with-at-least-32-random-characters
# Local registration demonstration only; never enable this verifier in a deployed environment.
DEV_VERIFICATION_CODE=123456
ACCESS_TOKEN_MINUTES=30

